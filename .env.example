# ─── Database (required) ──────────────────────────────────────────────
# Pooled connection string (Neon / Supabase pooled URL). Prisma uses this at runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
# Optional: direct (unpooled) URL for migrations, e.g. prisma migrate deploy.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── Admin (required to create the first admin user via seed) ─────────────
ADMIN_EMAIL="admin@example.com"
# bcrypt hash of the admin password. Generate with:
#   node -e "const b=require('bcryptjs'); b.hash('YOUR_PASSWORD', 10).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=""

# ─── Sessions ─────────────────────────────────────────────────────────────
# Secret for signing admin session tokens (jose). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://velora.vercel.app"
NEXT_PUBLIC_SITE_NAME="VÉLORA"

# ─── Optional analytics (uncomment to enable) ─────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="velora.vercel.app"
